{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: FastAPI (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "jinja": false,
      "justMyCode": true
    },
    {
      "name": "API: tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": false
    },
    {
      "name": "Web: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "web: dev"
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["API: FastAPI (debug)", "Web: Chrome"],
      "stopAll": true
    }
  ]
}
