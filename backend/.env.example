# Copy to backend/.env for running the API outside Docker.
DATABASE_URL=postgresql+psycopg://expeditors:expeditors@localhost:5432/expeditors
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
# Optional: email every new quote request. NOTIFY_EMAIL takes several addresses separated by commas.
# SMTP_USER is the Gmail account that sends the emails; Gmail needs an app password, not the normal one.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=expeditorsafrica@gmail.com
# SMTP_PASSWORD=app-password
# NOTIFY_EMAIL=expeditorsafrica@gmail.com
